<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SideLock</AssemblyName>
    <RootNamespace>SideLock</RootNamespace>
    <ApplicationIcon>sidelock.ico</ApplicationIcon>
    <AssemblyTitle>SideLock</AssemblyTitle>
    <Product>SideLock</Product>
    <Description>Tray utility that blocks mouse side-button navigation.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="sidelock.ico" />
  </ItemGroup>
</Project>
